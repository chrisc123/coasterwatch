{
  "name": "energylandia-queues",
  "author": "Chris Cole",
  "license": "MIT",
  "version": "1.1.1",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "scripts": {
    "test": "node test/settings-webview.test.js && node test/graphing.test.js"
  },
  "pebble": {
    "displayName": "CoasterWatch",
    "uuid": "bfb961de-36d9-4dd9-8ebb-012d719a715e",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable",
      "location"
    ],
    "messageKeys": [
      "RequestRefresh",
      "TotalCount",
      "RideIndex",
      "RideId",
      "RideName",
      "RideWait",
      "RideDistance",
      "ErrorMsg",
      "RequestGraph",
      "GraphCount",
      "GraphIndex",
      "GraphWait",
      "GraphMinuteOfDay",
      "GraphError",
      "BandThreshold1",
      "BandThreshold2",
      "BandColor0",
      "BandColor1",
      "BandColor2",
      "AlertColor",
      "VibePattern",
      "GraphPegMinuteOfDay"
    ],
    "resources": {
      "media": [
        { "type": "bitmap", "name": "MENU_ICON", "file": "icon.png", "menuIcon": true },
        { "type": "font", "name": "RIDE_NAME_FONT_16", "file": "fonts/RobotoCondensed-Bold.ttf",
          "characterRegex": "[A-Za-z0-9 :.,'’©ąćęłńóśźżĄĆĘŁŃÓŚŹŻ-]",
          "targetPlatforms": ["basalt", "chalk", "emery", "gabbro"] }
      ]
    }
  },
  "devDependencies": {
    "jsdom": "^24.1.3"
  },
  "dependencies": {
    "@rebble/clay": "^1.1.0"
  }
}
